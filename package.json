{
  "name": "quartr-coding-task",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite frontend --config frontend/vite.config.ts",
    "dev:backend": "bun --watch backend/index.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "tsc -b frontend && vite build frontend --config frontend/vite.config.ts",
    "build:backend": "bun build backend/index.ts --outdir backend/dist --target bun",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "tsc -b frontend --pretty false",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit --pretty false",
    "start": "npm run start:backend",
    "start:backend": "bun backend/dist/index.js",
    "preview:frontend": "vite preview frontend --config frontend/vite.config.ts"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
